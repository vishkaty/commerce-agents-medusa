# Copy to .env in the directory you run from; the process environment overrides it.
# Never commit a real key. The Anthropic credential is not read here: the agents run on
# the Claude Agent SDK, which uses its own login or the SDK's credential chain.

# Medusa v2 store (Store API needs a publishable key linked to a sales channel)
MEDUSA_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_KEY=
MEDUSA_ADMIN_EMAIL=
MEDUSA_ADMIN_PASSWORD=

# The single customer the reference storefront's demo profiles map to
LAB_CUSTOMER_EMAIL=
LAB_CUSTOMER_PASSWORD=
CUSTOMER_ID=customer
CUSTOMER_NAME=Customer
OPERATOR=operator
STORE_NAME=Demo Store

# Stripe test mode: hosted Checkout Sessions and the webhook that places the order
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRETS=

# Where the host keeps its files, and the host's public URL for Stripe's return pages
DATA_DIR=data
LAB_HOST_URL=http://localhost:8010
LAB_CURRENCY=usd

# Optional: a checkout of anthropics/commerce-agents for the merchant fixtures
# (examples/retail/data) and the retail catalog import
COMMERCE_AGENTS=

# Optional: the read-only Postgres DSN for the merchant's analysis replica
DATABASE_URL_RO=
